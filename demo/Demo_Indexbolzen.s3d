            <contour-item><reverse>0</reverse><edge-ref>Edge-8</edge-ref></contour-item>
            <contour-item><reverse>0</reverse><edge-ref>Edge-10</edge-ref></contour-item>
            <contour-item><reverse>0</reverse><edge-ref>Edge-11</edge-ref></contour-item>
          </contour></contours>
        </face>
      </faces>
    </model>
  </models>
</classmate-cad>
